# Full TB-dev: 70 tasks x 8 samples, eval only; 64k context with summarize. COMMON=common_ota_single_node;
# 2 GPUs (one TP=2 engine; recommended: H100 or larger).
# PRL_SANDBOX_PROVIDER=e2b makes run_job.sh check the site profile's sandbox endpoint.
# PRL_TEMPLATE_MANIFEST binds immutable task contexts to ready templates.
MODE=rollout
# Eval-only two-GPU layout; no training actor is started in debug-rollout-only mode.
NUM_GPUS=2
NNODES=1
ACTOR_NODES=1
ACTOR_GPUS_PER_NODE=2
ROLLOUT_GPUS=2
COLOCATE=1
NUM_ROLLOUT=0
ROLLOUT_BATCH=2
N_SAMPLES=1
KL_LOSS_COEF=0
# EXTRA_ARGS is appended after the launcher's default one-GPU engine flag.
# Miles maps GPUs per engine to SGLang TP; semaphore = 16 * 2 / 2 = 16.
EXTRA_ARGS="--rollout-num-gpus-per-engine 2 --num-gpus-per-node 2 --sglang-server-concurrency 16 --use-session-server v2 --session-sample-picker-path prl.rollout.eval_sample_picker.latest_eval_leaf"
# Total context includes task, retained thinking, replies and observations.
# Keep all context/collection metadata aligned; the wrapper omits per-call max_tokens.
# Summary replaces history: v2 accepts branches; eval picker keeps one result per trial.
HARBOR_TERMINUS_2_ENABLE_SUMMARIZE=true
MAX_CONTEXT=65536
HARBOR_MAX_SEQ_LEN=65536
AGENT_MAX_INPUT_TOKENS=65536
AGENT_MAX_OUTPUT_TOKENS=63488
MAX_RESPONSE=63488
SAVE_INTERVAL=
EVAL_DATA=$PRL_EXT/data/ot_tbdev/tbdev.jsonl
PROMPT_DATA=$EVAL_DATA
# Use the exact build-context snapshot, including permissions, without changing shared tasks.
# The TB-dev snapshot, best with tmux preinstalled (make_task_snapshot.py --tmux; 51 of the 70 images have it already,
# and Harbor's install of it at the start of a trial can abort the trial); the tasks and tests are the same either way.
HARBOR_TASKS_DIR=$PRL_EVAL_SNAPSHOT/tasks
EVAL_INTERVAL=1
EVAL_N_SAMPLES=8
# A failed trial scores 0, including one the sandbox service failed (a rate limit, an internal error), as every earlier
# evaluation scored it. PRL_EVAL_SANDBOX_RETRIES=2 runs those again instead (prl/rollout/harbor_training.py), and
# tbdev_score.py --samples 8 then drops the failed attempts.
EVAL_TEMPERATURE=1.0
EVAL_TOP_P=1.0
PRL_SANDBOX_PROVIDER=e2b
PRL_TEMPLATE_MANIFEST=$PRL_EVAL_SNAPSHOT/manifest.json
unset E2B_API_KEY E2B_SANDBOX_URL
PRL_EXTRA_PYTHONPATH=$PRL_EXT/pydeps_e2b_sdk
HARBOR_ENV_KWARGS="{\"prl_template_manifest\":\"$PRL_TEMPLATE_MANIFEST\",\"prl_max_concurrent_trials\":16,\"sandbox_timeout_secs\":1800,\"renew_interval\":300}"
HARBOR_OVERRIDE_CPUS=2
HARBOR_OVERRIDE_MEMORY_MB=2048
unset HARBOR_OVERRIDE_STORAGE_MB
HARBOR_TRIALS_DIR=$PRL_EXT/runs/grpo_ota_eval_tbdev70_64k_summary_c16_${JOB_ID}/harbor_trials
AGENT_TRIAL_TIMEOUT=7800
# Long tasks allow 3600s agent + 3600s verifier; retain their own timeout x1.0.
RUN_DIR=$PRL_EXT/runs/grpo_ota_eval_tbdev70_64k_summary_c16_${JOB_ID}
