# Full OTA PPO: the turn-capped 64 x 8 GRPO arm (ota_train_full.env, sourced below) with the advantage from a
# learned critic instead of the group mean. Everything else is identical (64 x 8, lr 1e-6, KL loss k3 0.001, clip 0.2,
# 64k + summarize, 64 concurrent trials, 32 Terminus-2 turns), so the actor still gets 34 updates.
# Value pretraining: the first CRITIC_WARMUP_STEPS rollouts train only the critic on the frozen
# actor's own samples; Miles saves only the critic during them. Critic lr / gamma / lambda / advantage whitening follow
# Miles' examples/ppo (critic 1e-5 vs actor 1e-6). Relay: scripts/chain/grpo_full.sh, critic resume: critic_load.
source "$PRL_ROOT/configs/arms/ota_train_full.env"
ADVANTAGE_ESTIMATOR=ppo
CRITIC_WARMUP_STEPS=10
CRITIC_LR=1e-5
GAE_GAMMA=1.0
GAE_LAMBDA=1.0
NORMALIZE_ADVANTAGES=1
# Value head init (patches miles/0006, 0008): `upstream` (default) keeps Miles' init. The critic loads the base
# LM checkpoint, so its 1-wide head is that checkpoint's output-layer row 0: values about +-6, value loss ~41 at
# rollout 0 (in three PPO runs). `zero` starts from V = 0; an overlay arm sets PRL_VALUE_HEAD_INIT=zero.
PRL_VALUE_HEAD_INIT=${PRL_VALUE_HEAD_INIT:-upstream}
NUM_ROLLOUT=$((CRITIC_WARMUP_STEPS + 34))
# The actor's 20th update (the GRPO run kept iter 19 for OpenThinker's eval cadence) is rollout 29.
PRL_KEEP_ITERS="29"
RUN_DIR=$PRL_EXT/runs/ppo_ota_train_full_${PRL_RUN_ID:?set PRL_RUN_ID, shared by all jobs of the relay}
HARBOR_TRIALS_DIR=$RUN_DIR/harbor_trials/job_${JOB_ID}
