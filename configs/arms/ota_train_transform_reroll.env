# Training with a transform that rerolls (step.reroll(), e.g. TRANSFORM=rewrite with {"added": "reroll"}, or a user's
# own; transforms/README.md "Reroll"): ota_train_transform.env plus the post-process a reroll needs, so the
# reroll trains as one more member of its prompt's group with its own verifier reward (prl/algo/added_rewards.py;
# without added samples the result is Miles' own normalization).
#   CHAIN=train_eval ARM=ota_train_transform_reroll TRANSFORM=<name> PRL_RUN_ID=<id> \
#     bash scripts/submit.sh
# ALGO=grpo or ppo (under PPO the reroll's reward goes in as it is, against the critic). Not REINFORCE++: the post-process
# normalizes within groups, which REINFORCE++ does not.
case ${ALGO:-grpo} in
  grpo|ppo) ;;
  *) echo "a reroll arm needs ALGO=grpo or ppo, got ${ALGO}" >&2; return 1 ;;
esac
source "$PRL_ROOT/configs/arms/ota_train_transform.env"
EXTRA_ARGS="$EXTRA_ARGS --custom-reward-post-process-path prl.algo.added_rewards.group_rewards"
