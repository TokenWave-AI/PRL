# GRPO 32 x 8 with signed ATLAS (transforms/atlas_signed.py): the judge grades the
# policy's steps good / bad (at most 30% each), and bad steps get negative weights. PRL_TRANSFORM_ARGS picks
# the mode:
# '{"mode": "mild"}' (plain GRPO + the mistakes of passed trials pushed down) or '{"mode": "strict"}' (only graded steps
# train). The ota_train_transform.env recipe (no turn cap, 68 updates) with the judge at low reasoning effort
# (its reasons are read only for debugging). Not PPO: the critic, not the outcome, sets each token's sign there.
#   CHAIN=train_eval ARM=ota_train_atlas_signed TRANSFORM=atlas_signed \
#     PRL_TRANSFORM_ARGS='{"mode": "mild"}' PRL_RUN_ID=... bash scripts/submit.sh
[ "${ALGO:-grpo}" != ppo ] || { echo "signed ATLAS needs one advantage sign per trial: ALGO=grpo or reinforce_plus_plus" >&2; return 1; }
PRL_JUDGE_EXTRA_BODY=${PRL_JUDGE_EXTRA_BODY:-'{"reasoning_effort": "low"}'}
TRANSFORM=${TRANSFORM:-atlas_signed}
source "$PRL_ROOT/configs/arms/ota_train_transform.env"
