# Full GRPO from the base model, matching ota_train_full.env (sourced below) except for the Terminus-2 turn cap.
# Keep 64 x 8, 34 updates, 64k + summarize and the task timeouts; evaluate with the noturncap TB-dev arm.
# Use a fresh PRL_RUN_ID so this does not resume the earlier 32-turn training.
source "$PRL_ROOT/configs/arms/ota_train_full.env"
unset HARBOR_AGENT_MAX_ITERATIONS
