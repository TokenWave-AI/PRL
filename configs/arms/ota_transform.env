# A trajectory transform (transforms/$TRANSFORM.py, prl/transforms/core.py) and the model it may ask (the judge
# profile), on top of any training arm; not an arm by itself. Sourced by ota_train_transform.env and
# ota_train_smoke_transform.env. The launchers check the transform on recorded trials before training
# (prl/transforms/check.py); no per-transform smoke.
source "$PRL_ROOT/configs/arms/ota_judge.env"
PRL_TRANSFORM=${TRANSFORM:?set TRANSFORM to the file name of transforms/<name>.py}
# Params overriding the function's defaults (a JSON object). From a file when submitted: pjsub -x / qsub -v split at
# commas (scripts/lib/submit_chain.sh writes it).
PRL_TRANSFORM_ARGS=${PRL_TRANSFORM_ARGS:-$(if [ -n "${PRL_TRANSFORM_ARGS_FILE:-}" ]; then cat "$PRL_TRANSFORM_ARGS_FILE"; fi)}
