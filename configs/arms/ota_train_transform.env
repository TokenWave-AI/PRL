# Training with a trajectory transform (TRANSFORM=<name> runs transforms/<name>.py) on the standard 32 x 8 recipe:
#   ALGO=grpo (default): the no-turn-cap GRPO arm at 32 x 8, 68 updates (ota_train_full_noturncap_b32);
#   ALGO=ppo: the PPO arm at 32 x 8, 20 critic-only + 68 updates (ota_train_full_ppo_b32);
#   ALGO=reinforce_plus_plus: REINFORCE++ at 32 x 8, 68 updates, no turn cap (ota_train_full_rpp_b32).
# Submit with CHAIN=train_eval (scripts/submit.sh: training -> export -> TB-dev). The run directory is named by
# algorithm and transform; PRL_RUN_ID is shared by the relay's jobs.
case ${ALGO:-grpo} in
  grpo) source "$PRL_ROOT/configs/arms/ota_train_full_noturncap_b32.env" ;;
  ppo) source "$PRL_ROOT/configs/arms/ota_train_full_ppo_b32.env" ;;
  reinforce_plus_plus) source "$PRL_ROOT/configs/arms/ota_train_full_rpp_b32.env" ;;
  *) echo "ALGO must be grpo, ppo or reinforce_plus_plus, got ${ALGO}" >&2; return 1 ;;
esac
source "$PRL_ROOT/configs/arms/ota_transform.env"
RUN_DIR=$PRL_EXT/runs/${ALGO:-grpo}_ota_train_tf_${TRANSFORM}_${PRL_RUN_ID:?set PRL_RUN_ID, shared by all jobs of the relay}
HARBOR_TRIALS_DIR=$RUN_DIR/harbor_trials/job_${JOB_ID}
