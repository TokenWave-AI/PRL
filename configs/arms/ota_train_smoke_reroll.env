# Framework smoke of rerolls (step.reroll()): the transform smoke
# with TRANSFORM=reroll_smoke (transforms/reroll_smoke.py: no teacher; each whole trial of >= 3 turns rerolls from its
# middle turn, the turn before it edited) and the group-reward post-process a reroll needs (its own reward as one more
# group member; without added samples the result is Miles' normalization, prl/algo/added_rewards.py):
#   CHAIN=smoke_grpo ARM=ota_train_smoke_reroll TRANSFORM=reroll_smoke bash scripts/submit.sh
# Acceptance (scripts/checks/grpo_acceptance.py check_rerolls): at least one reroll scored and trained.
TRANSFORM=${TRANSFORM:-reroll_smoke}
source "$PRL_ROOT/configs/arms/ota_train_smoke_transform.env"
EXTRA_ARGS="$EXTRA_ARGS --custom-reward-post-process-path prl.algo.added_rewards.group_rewards"
