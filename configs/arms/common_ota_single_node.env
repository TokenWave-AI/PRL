# common_ota.env (OpenThinker run_otagent.sh parity) on one node of 4 GPUs (recommended: H100 95 GB or GB200): the
# base of every ota_* arm. scripts/lib/chain.sh sources it before the arm (COMMON=common_ota_single_node for
# scripts/run_job.sh), after the site profile, so $PRL_EXT/$PRL_SCRATCH are set.
source "$PRL_ROOT/configs/arms/common_ota.env"
# Harbor writes each trial's files here; must sit under PRL_SCRATCH (bound into the container).
HARBOR_TRIALS_DIR=$PRL_SCRATCH/harbor_trials
# One node = 4 GPUs + >= 768 GB host RAM (recommended GPUs: >= 90 GB each, e.g. H100 95 GB or GB200): 2 training GPUs
# + 2 SGLang engines, Adam fully on the host (common_ota.env's multi-node layout: 4 trainer + 2 rollout single-GPU
# nodes with about 100 GB host RAM each).
# Rollout-only smokes override to 1 GPU.
NUM_GPUS=4
# The hardware gate (scripts/lib/guard.sh) checks NUM_GPUS and this: the memory settings here were sized on >= 90 GB GPUs
PRL_GPU_MIN_MIB=90000
NNODES=1
COLOCATE=0
ASYNC=0
ACTOR_NODES=1
ACTOR_GPUS_PER_NODE=2
ROLLOUT_GPUS=2
PRL_ROLLOUT_ON_HEAD=0        # single node: nothing to pin (patch 0005's --pin-rollout-manager-to-head dropped)
EXTRA_ARGS="--calculate-per-token-loss --use-distributed-optimizer --optimizer-cpu-offload --optimizer-offload-fraction 1.0 --overlap-cpu-optimizer-d2h-h2d --use-precision-aware-optimizer --no-save-rng --no-load-rng"
