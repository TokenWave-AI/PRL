# Full OTA PPO at half the batch and twice the updates:
# ota_train_full_ppo.env (sourced below) with 32 x 8 per rollout instead of 64 x 8 over the same 2816
# prompts, so the critic gets 20 critic-only updates and the actor 68 instead of 10 and 34. Still one optimizer step
# per rollout (global batch = ROLLOUT_BATCH x N_SAMPLES); lr, KL, clip and the critic settings are unchanged.
source "$PRL_ROOT/configs/arms/ota_train_full_ppo.env"
ROLLOUT_BATCH=32
# Miles requires over_sampling_batch_size >= rollout_batch_size; equal, as at 64.
OVER_SAMPLING_BATCH=32
CRITIC_WARMUP_STEPS=20
NUM_ROLLOUT=$((CRITIC_WARMUP_STEPS + 68))
# The actor's 40th update: the prompts the 64-per-rollout arms have seen at their actor's 20th.
PRL_KEEP_ITERS="$((CRITIC_WARMUP_STEPS + 39))"
