# Same planned prompt budget as the unlimited-turn 64 x 8 GRPO arm: 68 x 32 = 34 x 64.
# One on-policy optimizer update per rollout; keep lr and every other training setting unchanged.
source "$PRL_ROOT/configs/arms/ota_train_full_noturncap.env"
ROLLOUT_BATCH=32
OVER_SAMPLING_BATCH=32
NUM_ROLLOUT=68
# Actor update 40 has the same planned prompt exposure as update 20 of the 64-prompt arm.
PRL_KEEP_ITERS="39"
