# 2 native GRPO updates, first 8 OTA tasks x 8 samples; one node of 4 GPUs (recommended: H100 95 GB or GB200).
# COMMON=common_ota_single_node. Training TP=1/DP=2; inference one TP=2 engine.
MODE=train
NUM_GPUS=4
NNODES=1
ACTOR_NODES=1
ACTOR_GPUS_PER_NODE=2
ROLLOUT_GPUS=2
COLOCATE=0
ASYNC=0
ROLLOUT_BATCH=8
N_SAMPLES=8
NUM_ROLLOUT=2
OVER_SAMPLING_BATCH=8
PRL_REJECT_MISMATCH=${PRL_REJECT_MISMATCH:-1}
PRL_MISMATCH_MAX_RETRIES=${PRL_MISMATCH_MAX_RETRIES:-2}
DYN_FILTER=none
MAX_CONTEXT=65536
HARBOR_MAX_SEQ_LEN=65536
AGENT_MAX_INPUT_TOKENS=65536
AGENT_MAX_OUTPUT_TOKENS=63488
MAX_RESPONSE=63488
HARBOR_TERMINUS_2_ENABLE_SUMMARIZE=true
# --check-weight-update-equal: Miles scrambles the engine's weights before the trainer's first sync (Miles'
# server_cell.py reset_tensors), so a tensor the sync misses leaves garbage, which the acceptance's train/rollout
# log-prob bound catches. The vision tower is never synced (text-only training): skipped.
# Adam states stay fp32 (a 4-GPU node's >= 768 GB host RAM holds them); a bf16 offload was only needed on a 2-GPU
# node with half that host memory.
EXTRA_ARGS="$EXTRA_ARGS --check-weight-update-equal --check-weight-update-skip-list visual. --rollout-num-gpus-per-engine 2 --num-gpus-per-node 4 --sglang-server-concurrency 16 --use-session-server v2 --custom-generate-function-path prl.rollout.harbor_training.generate --custom-agent-function-path prl.rollout.harbor_training.run --session-sample-picker-path prl.rollout.training_samples.pick_samples --session-sample-postprocessor-path prl.rollout.training_samples.postprocess_samples"
PROMPT_DATA=$PRL_TRAIN_SNAPSHOT/smoke.jsonl
# The tasks and templates are the training snapshot's (as in ota_train_full.env), so the smoke runs on the same
# sandboxes as training; PROMPT_DATA is its first 8 rows (make_task_snapshot.py --smoke 8).
HARBOR_TASKS_DIR=$PRL_TRAIN_SNAPSHOT/tasks
EVAL_DATA=
SKIP_EVAL_BEFORE_TRAIN=1
SAVE_INTERVAL=2
PRL_SANDBOX_PROVIDER=e2b
PRL_TEMPLATE_MANIFEST=$PRL_TRAIN_SNAPSHOT/manifest.json
unset E2B_API_KEY E2B_SANDBOX_URL
PRL_EXTRA_PYTHONPATH=$PRL_EXT/pydeps_e2b_sdk
# Force one summary per continuing training trial solely to test compact masks.
HARBOR_ENV_KWARGS="{\"prl_template_manifest\":\"$PRL_TEMPLATE_MANIFEST\",\"prl_max_concurrent_trials\":16,\"prl_force_summary_once\":true,\"sandbox_timeout_secs\":1800,\"renew_interval\":300}"
HARBOR_OVERRIDE_CPUS=2
HARBOR_OVERRIDE_MEMORY_MB=2048
unset HARBOR_OVERRIDE_STORAGE_MB
RUN_DIR=$PRL_EXT/runs/grpo_ota_train_smoke_${JOB_ID}
HARBOR_TRIALS_DIR=$RUN_DIR/harbor_trials
AGENT_TRIAL_TIMEOUT=7800
