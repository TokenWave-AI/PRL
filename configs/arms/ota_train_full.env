# Full OTA native GRPO; COMMON=common_ota_single_node. GPU split: 2 train + 2 inference (one TP=2 engine).
# Relayed over consecutive 24 h jobs that share PRL_RUN_ID (scripts/chain/grpo_full.sh, scripts/lib/relay.sh).
# TB-dev is evaluated after training from saved checkpoints, under the turn-capped c16 eval arm the base model was
# evaluated with (ota_eval_tbdev70_64k_summary_c16.env).
MODE=train
NUM_ROLLOUT=34
ROLLOUT_BATCH=64
N_SAMPLES=8
OVER_SAMPLING_BATCH=64
# Mismatched trajectories train with their verifier reward (Miles only logs tito_session_mismatch_rate).
# 1 = drop and resample them instead (prl/rollout/harbor_training.py).
PRL_REJECT_MISMATCH=${PRL_REJECT_MISMATCH:-0}
PRL_MISMATCH_MAX_RETRIES=${PRL_MISMATCH_MAX_RETRIES:-2}
DYN_FILTER=none
MAX_CONTEXT=65536
HARBOR_MAX_SEQ_LEN=65536
AGENT_MAX_INPUT_TOKENS=65536
AGENT_MAX_OUTPUT_TOKENS=63488
MAX_RESPONSE=63488
HARBOR_TERMINUS_2_ENABLE_SUMMARIZE=true
# Concurrent trials. At 16 the engine idled (GRPO smoke: median 10 requests generating, KV <= 3% of ~2.3M tokens;
# base-model TB-dev eval: 6 of 16 trial slots generating). Miles gates whole trials per engine with
# --sglang-server-concurrency (one engine here); the Harbor wrapper's cap must match.
PRL_TRIAL_CONCURRENCY=${PRL_TRIAL_CONCURRENCY:-64}   # an overlay arm may set it before sourcing this file
EXTRA_ARGS="$EXTRA_ARGS --rollout-num-gpus-per-engine 2 --num-gpus-per-node 4 --sglang-server-concurrency $PRL_TRIAL_CONCURRENCY --use-session-server v2 --custom-generate-function-path prl.rollout.harbor_training.generate --custom-agent-function-path prl.rollout.harbor_training.run --session-sample-picker-path prl.rollout.training_samples.pick_samples --session-sample-postprocessor-path prl.rollout.training_samples.postprocess_samples"
PROMPT_DATA=$PRL_EXT/data/otagent_rl/train.jsonl
# No in-training eval (3 h per TB-dev pass on the training node). TBDEV_DATA is only checked for disjointness.
EVAL_DATA=
TBDEV_DATA=$PRL_EXT/data/ot_tbdev/tbdev.jsonl
# A checkpoint every update (117 GB with fp32 Adam; saving took 55 s on average and 104 s at most, 2-8% of an update in
# two full 68-update transform runs), so a job reaching its time limit loses at most one step. The launcher
# prunes older ones, except PRL_KEEP_ITERS (step 20 = OpenThinker's eval cadence); the final one stays as latest.
SAVE_INTERVAL=1
PRL_KEEP_ITERS="19"
# The training snapshot, best with tmux preinstalled (make_task_snapshot.py --tmux: Harbor's install of it at the start
# of a trial can time out or fail and abort the trial).
HARBOR_TASKS_DIR=$PRL_TRAIN_SNAPSHOT/tasks
PRL_SANDBOX_PROVIDER=e2b
PRL_TEMPLATE_MANIFEST=$PRL_TRAIN_SNAPSHOT/manifest.json
unset E2B_API_KEY E2B_SANDBOX_URL
PRL_EXTRA_PYTHONPATH=$PRL_EXT/pydeps_e2b_sdk
# Formal training keeps natural summarization; no smoke-only forced summary.
HARBOR_ENV_KWARGS="{\"prl_template_manifest\":\"$PRL_TEMPLATE_MANIFEST\",\"prl_max_concurrent_trials\":$PRL_TRIAL_CONCURRENCY,\"sandbox_timeout_secs\":1800,\"renew_interval\":300}"
HARBOR_OVERRIDE_CPUS=2
HARBOR_OVERRIDE_MEMORY_MB=2048
unset HARBOR_OVERRIDE_STORAGE_MB
# Shared by every job of the relay: a per-job directory would restart from step 0.
RUN_DIR=$PRL_EXT/runs/grpo_ota_train_full_${PRL_RUN_ID:?set PRL_RUN_ID, shared by all jobs of the relay}
# Per job: trials of a step cut off by the time limit never reach training; keep them apart from the trained ones.
HARBOR_TRIALS_DIR=$RUN_DIR/harbor_trials/job_${JOB_ID}
AGENT_TRIAL_TIMEOUT=7800
