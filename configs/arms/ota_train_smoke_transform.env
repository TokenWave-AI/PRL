# Framework smoke of trajectory transforms (it validates the framework; the quick start's try on the smoke's 8 tasks
# runs it with your transform; a training job checks your transform by itself): the GRPO smoke without the turn cap
# (ALGO=grpo, default) or the two-job PPO smoke (ALGO=ppo; PRL_RUN_ID and PRL_PPO_SMOKE_ROLLOUTS as in
# ota_train_smoke_ppo.env), with
# TRANSFORM=<name> and the judge profile. Its acceptance receipt names the framework sources it ran
# (scripts/checks/grpo_acceptance.py), not the transform.
case ${ALGO:-grpo} in
  grpo) source "$PRL_ROOT/configs/arms/ota_train_smoke_noturncap.env" ;;
  ppo) source "$PRL_ROOT/configs/arms/ota_train_smoke_ppo.env" ;;
  *) echo "ALGO must be grpo or ppo, got ${ALGO}" >&2; return 1 ;;
esac
source "$PRL_ROOT/configs/arms/ota_transform.env"
# Split only half of the trials by a forced summary: rewriting needs a trial in one piece (a smoke that split every
# successful trial rewrote none); the other half still exercises summary masks.
HARBOR_ENV_KWARGS=${HARBOR_ENV_KWARGS/\"prl_force_summary_once\":true/\"prl_force_summary_once\":0.5}
