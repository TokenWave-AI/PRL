# PPO smoke: the 8-task GRPO smoke (ota_train_smoke.env, sourced below) with a critic, run as two jobs on
# one RUN_DIR so that the critic's value pretraining, the PPO update and a resume of both models are all exercised:
#   job A: PRL_PPO_SMOKE_ROLLOUTS=2 -> rollout 0 trains only the critic, rollout 1 is PPO; both saved at 1
#   job B: PRL_PPO_SMOKE_ROLLOUTS=3, PRL_SMOKE_RESUME_FROM=1 -> resumes actor + critic, rollout 2 is PPO
# Shared directory: PRL_RUN_ID=<id>, which CHAIN=smoke_ppo passes to both.
# Acceptance: scripts/checks/grpo_acceptance.py.
source "$PRL_ROOT/configs/arms/ota_train_smoke.env"
ADVANTAGE_ESTIMATOR=ppo
CRITIC_WARMUP_STEPS=1
CRITIC_LR=1e-5
GAE_GAMMA=1.0
GAE_LAMBDA=1.0
NORMALIZE_ADVANTAGES=1
# Value head init: as ota_train_full_ppo.env (`upstream`; PRL_VALUE_HEAD_INIT=zero must reach both jobs)
PRL_VALUE_HEAD_INIT=${PRL_VALUE_HEAD_INIT:-upstream}
# Both jobs plan 3 rollouts: Megatron's LR scheduler stores the run length in the checkpoint and refuses a resume
# that changes it ("class input value 192 and checkpointvalue 128 for total number of iterations do
# not match"). Job A stops after 2 with Miles' --debug-exit-after-rollout, which exists for this resume test.
NUM_ROLLOUT=3
case ${PRL_PPO_SMOKE_ROLLOUTS:?2 for job A, 3 for job B} in
  2) EXTRA_ARGS="$EXTRA_ARGS --debug-exit-after-rollout 2" ;;
  3) ;;
  *) echo "PRL_PPO_SMOKE_ROLLOUTS must be 2 (job A) or 3 (job B)" >&2; return 1 ;;
esac
# Saves every rollout (8 tasks = one rollout per epoch, an epoch boundary is a save trigger) and the last: ~117 GB
# per model per save, about 0.6 TB for the whole smoke.
RUN_DIR=$PRL_EXT/runs/ppo_ota_train_smoke_${PRL_RUN_ID:?set PRL_RUN_ID, shared by both smoke jobs}
HARBOR_TRIALS_DIR=$RUN_DIR/harbor_trials/job_${JOB_ID}
