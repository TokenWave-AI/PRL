# Sync GRPO + ATLAS at 32 x 8 and 68 updates: the no-turn-cap 32 x 8 GRPO arm (ota_train_full_noturncap_b32.env,
# sourced below) with the same judge-labeled token mask as the 64 x 8 ATLAS arm (ota_atlas_judge.env).
source "$PRL_ROOT/configs/arms/ota_train_full_noturncap_b32.env"
source "$PRL_ROOT/configs/arms/ota_atlas_judge.env"
RUN_DIR=$PRL_EXT/runs/grpo_ota_train_atlas_${PRL_RUN_ID:?set PRL_RUN_ID, shared by all jobs of the relay}
HARBOR_TRIALS_DIR=$RUN_DIR/harbor_trials/job_${JOB_ID}
