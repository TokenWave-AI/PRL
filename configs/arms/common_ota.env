# Shared GRPO settings for OpenThoughts-Agent-v1-RL with Harbor Terminus-2, following OpenThinker-Agent's release RL
# script for this dataset: mlfoundations/SkyRL `dcagent` skyrl-train/run_otagent.sh (+ SkyRL defaults, Harbor
# CharlieFRuan/harbor@112425-terminus2-messages). Deviations from it are commented where they are set.
# Read at job start by the entry scripts (scripts/chain/*.sh) before the arm.
DATASET=otagent
MODE=train
MODEL_SIZE=9B                 # user's choice (OpenThinker: Qwen3-8B)
HARNESS=harbor
THINKING=true
# Terminus-2: max_episodes 32, enable_summarize false (run_otagent.sh); json parser + no asciinema
# (prl/rollout/harbor_agent.py); task timeouts x1.0 (Harbor default; Miles' recipe uses 2.0)
HARBOR_AGENT_MAX_ITERATIONS=32
HARBOR_TIMEOUT_MULTIPLIER=1.0
HARBOR_ENV_TYPE=e2b
# Sandboxes: one E2B sandbox per trial, on the E2B-compatible service the site profile names (E2B_API_URL, E2B_DOMAIN,
# E2B_API_KEY_FILE: configs/sites/example.env), created from each task's
# prebuilt template (images built from the task's environment/, pushed to a registry and registered as templates;
# docs/sandboxes.md). The template fixes the resources: 2 CPU / 2 GB / 15 GB disk
# (OpenThinker: 1 CPU / 1 GB / 1 GB); the overrides only match what Harbor records to the template.
HARBOR_OVERRIDE_CPUS=2
HARBOR_OVERRIDE_MEMORY_MB=2048
unset HARBOR_OVERRIDE_STORAGE_MB
HARBOR_TRIALS_DIR=/local/${USER}/harbor_trials   # must sit under PRL_SCRATCH, which is bound into the container
HARBOR_TELEMETRY=0
LITELLM_LOCAL_MODEL_COST_MAP=True
# The key stays in its file (E2B_API_KEY_FILE): only the path is forwarded, Miles' Harbor path reads it per worker
unset E2B_API_KEY E2B_SANDBOX_URL
# e2b SDK version the templates were validated with, ahead of $PRL_EXT/pydeps_harbor
PRL_EXTRA_PYTHONPATH=${PRL_EXT}/pydeps_e2b_sdk
PRL_SANDBOX_PROVIDER=e2b
# The task snapshots (scripts/tools/make_task_snapshot.py, docs/sandboxes.md): the task directories, the manifest that
# binds each to a ready template (harbor_agent.py reads it from HARBOR_ENV_KWARGS) and the task_check results. The
# training arms run on the training snapshot, the eval arms on the TB-dev one; a site profile may point elsewhere.
# Sandbox lifetime 30 min, renewed every 5 min.
PRL_TRAIN_SNAPSHOT=${PRL_TRAIN_SNAPSHOT:-$PRL_EXT/task_snapshots/otagent728}
PRL_EVAL_SNAPSHOT=${PRL_EVAL_SNAPSHOT:-$PRL_EXT/task_snapshots/tbdev70}
PRL_TEMPLATE_MANIFEST=$PRL_TRAIN_SNAPSHOT/manifest.json
HARBOR_ENV_KWARGS="{\"prl_template_manifest\":\"$PRL_TEMPLATE_MANIFEST\",\"sandbox_timeout_secs\":1800,\"renew_interval\":300}"
# Sequence budget: SkyRL max_prompt_length 2048 + max_generate_length 30720 = 32768 tokens per trajectory;
# per call the model may use whatever remains (SkyRL sets no per-call cap).
MAX_CONTEXT=32768
HARBOR_MAX_SEQ_LEN=32768      # Terminus-2 ends the trial once the trajectory would pass 32768 tokens
AGENT_MAX_INPUT_TOKENS=32768  # Terminus-2 model_info (Miles defaults 32768 / 8192 per call)
AGENT_MAX_OUTPUT_TOKENS=30720
MAX_RESPONSE=30720
MAX_TOKENS_PER_GPU=16384
SGLANG_MEM=0.85
ATTN_BACKEND=flash
# GRPO: 64 prompts x 8 samples, mini-batch = batch (one on-policy update), lr 1e-6, wd 0.01, KL loss k3 0.001,
# token-mean loss, clip 0.2/0.2, 3 epochs of 728 tasks (34 steps)
NUM_ROLLOUT=34
ROLLOUT_BATCH=64
N_SAMPLES=8
LR=1e-6
ADAM_BETA2=0.999             # SkyRL adam_betas [0.9, 0.999] (our Tmax-era default was 0.98)
EPS_CLIP=0.2
KL_LOSS_COEF=0.001
KL_LOSS_TYPE=k3
TEMPERATURE=1.0
TOP_P=1.0
# Eval: OpenThoughts-TB-dev x 8 every 20 steps and before training (eval_before_train=true). SkyRL's HTTP endpoint
# forces temperature 1.0 / top_p 1.0 on every request (vllm_engine.py _handle_openai_request), so eval also samples at 1.0
EVAL_DATA=${PRL_EXT}/data/ot_tbdev/tbdev.jsonl
EVAL_INTERVAL=20
EVAL_N_SAMPLES=8
EVAL_TEMPERATURE=1.0
EVAL_TOP_P=1.0
SAVE_INTERVAL=5
USE_TB=1
PRL_FUSED_LOGPROB=1
# 2048-token chunks (default 4096): one chunk's fp32 logits over the 248k vocab is 2 GB instead of 4 GB; at 4096 a
# 9B run hit a CUDA OOM at step 2 in the log-prob backward on a long sample. Row-wise, so the result does not
# depend on it.
PRL_FUSED_LOGPROB_CHUNK=2048
ROLLOUT_SEED=42
# Host memory per trainer node (100 GB): actor + ref weights pinned on the host for model switching (~41 GB, a full
# copy per rank) + CPU Adam shard + a ~25 GB spike when saving. Keep half the Adam shard on the GPU (41 GB free there).
EXTRA_ARGS="--calculate-per-token-loss --use-distributed-optimizer --optimizer-cpu-offload --optimizer-offload-fraction 0.5 --overlap-cpu-optimizer-d2h-h2d --use-precision-aware-optimizer --no-save-rng --no-load-rng --pin-rollout-manager-to-head"
# Layout: ACTOR_NODES trainer nodes + 2 rollout nodes, synchronous (OpenThinker trains on-policy); the arms set ACTOR_NODES.
# These settings assume single-GPU nodes (e.g. GH200) with 100 GB host memory for the job. 9B with the CPU-offloaded Adam state (fp32 master + m + v = 108 GB):
# 1 trainer rank OOMs at the first weight sync; 2 ranks (~66 GB RSS + ~41 GB pinned shmem each) OOM in the
# first optimizer step. 4 ranks shard it to ~27 GB each.
# The RolloutExecutor (+ router, session servers) otherwise lands on any node; on a trainer node it added the last
# few GB that host-OOM-killed it at the start of step 2 (trainer ranks grow 56 -> 70 GB RSS once the CPU
# Adam state exists). Pin it to the Ray head and make the head a rollout node (patches/miles/0005).
PRL_ROLLOUT_ON_HEAD=1
COLOCATE=0
ASYNC=0
ACTOR_NODES=4
ROLLOUT_GPUS=2
