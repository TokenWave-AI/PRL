# TB-dev 70 x 8 as ota_eval_tbdev70_64k_summary_c16.env (sourced below), without the
# Terminus-2 turn cap. common_ota.env sets HARBOR_AGENT_MAX_ITERATIONS=32 (run_otagent.sh max_episodes); unset, run.sh
# does not pass it, Miles' harbor_agent_function.py adds no max_turns and Terminus-2 falls back to 1000000. A trial
# then ends on task_complete, the task's agent timeout (TB-dev: 3600 s for 49 of 70) or AGENT_TRIAL_TIMEOUT.
# At 32, 29% of the base model's eval trials ran out of turns (47% of its failures).
# The default EVAL_ARM of scripts/lib/chain.sh; launcher scripts/chain/tbdev70_eval.sh:
#   PRL_SITE=<site> CHAIN=eval_hf MODEL_HF_DIR=<verified export> bash scripts/submit.sh   (CHAIN=eval_base: base)
source "$PRL_ROOT/configs/arms/ota_eval_tbdev70_64k_summary_c16.env"
unset HARBOR_AGENT_MAX_ITERATIONS
RUN_DIR=$PRL_EXT/runs/grpo_ota_eval_tbdev70_64k_summary_c16_noturncap_${MODEL:?pass -v MODEL=<configs/models name>}_${JOB_ID}
HARBOR_TRIALS_DIR=$RUN_DIR/harbor_trials
