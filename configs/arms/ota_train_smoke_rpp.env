# Two REINFORCE++ updates (ota_train_full_rpp_b32) and summary masking without the training turn cap: the
# no-turn-cap GRPO smoke with the estimator changed. Its receipt records the algorithm, which the full launcher and
# scripts/checks/find_smoke.py require to match the run's (ALGO=reinforce_plus_plus).
#   CHAIN=smoke+train_eval ALGO=reinforce_plus_plus SMOKE_ARM=ota_train_smoke_rpp ARM=... bash scripts/submit.sh
source "$PRL_ROOT/configs/arms/ota_train_smoke_noturncap.env"
ADVANTAGE_ESTIMATOR=reinforce_plus_plus
NORMALIZE_ADVANTAGES=1
RUN_DIR=$PRL_EXT/runs/reinforce_plus_plus_ota_train_smoke_${JOB_ID}
HARBOR_TRIALS_DIR=$RUN_DIR/harbor_trials
