# MoE smoke on two nodes of 4 GPUs (8 GPUs; recommended: H100 95 GB): the GRPO smoke without the turn cap
# (2 updates, the first 8 OTA tasks x 8) on Qwen3.6-35B-A3B, experts over 8 ranks (EP8, 32 of the 256 per GPU,
# ~7.3B parameters each). One node would hold 64 experts per GPU (EP4: ~71 GB of bf16 weights + fp32 grads of
# 95 GB), and an earlier attempt on 2 trainer GPUs (EP2, 128 experts per GPU) exceeded Transformer Engine's tensor
# limit in its first update's gradient clipping: hence 2 nodes with EP8. This arm has not yet run through.
#   CHAIN=download+convert+smoke SMOKE_ARM=ota_train_smoke_moe MODEL=qwen3.6-35B-A3B bash scripts/submit.sh
# Placement: colocated on both nodes (training on all 8 GPUs, then rollout on the same 8: 4 SGLang engines of TP2, each
# inside a node); the second node joins as a Ray worker (scripts/lib/chain.sh start_workers); the rollout manager,
# router, session servers and Harbor trials stay on the head (--pin-rollout-manager-to-head).
# OTA_R3=0: the router decides again in training; OTA_DUMP_ROUTES=1 keeps the routes in the trace dumps;
# OTA_PAUSE_MODE: retract (synchronous; in_place keeps the old weights' prefix cache) or in_place.
source "$PRL_ROOT/configs/arms/ota_train_smoke_noturncap.env"
# Not yet with the weight-update check (ota_train_smoke.env): untested with colocated, offloaded engines
EXTRA_ARGS=${EXTRA_ARGS/--check-weight-update-equal --check-weight-update-skip-list visual. /}
NNODES=2
NUM_GPUS=4   # per node
COLOCATE=1
PRL_ROLLOUT_ON_HEAD=0   # colocated: training and rollout use the same GPUs, nothing to reorder
SGLANG_MEM=0.7   # of what the offloaded trainer leaves (Miles' colocated recipes)
EXTRA_ARGS="$EXTRA_ARGS --expert-model-parallel-size 8 --expert-tensor-parallel-size 1 --mtp-num-layers 0"
EXTRA_ARGS="$EXTRA_ARGS --pin-rollout-manager-to-head"
PRL_FUSED_LOGPROB_CHUNK=${OTA_FUSED_LOGPROB_CHUNK:-512}  # at 2048 the MoE hit a CUDA OOM in the log-prob backward
if [ "${OTA_R3:-1}" = 1 ]; then
  EXTRA_ARGS="$EXTRA_ARGS --use-rollout-routing-replay --pause-generation-mode ${OTA_PAUSE_MODE:-retract}"
fi
if [ "${OTA_DUMP_ROUTES:-0}" = 0 ]; then EXTRA_ARGS="$EXTRA_ARGS --dump-without-routed-experts"; fi
