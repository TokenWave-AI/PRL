# The transform smoke (ota_train_smoke_transform.env: 2 GRPO updates on the smoke's 8 tasks) with signed ATLAS and its
# judge at low reasoning effort, as in the full run (ota_train_atlas_signed.env). scripts/quickstart.sh runs it when
# only the smoke's sandboxes are built:
#   CHAIN=smoke_grpo ARM=ota_train_smoke_atlas_signed TRANSFORM=atlas_signed bash scripts/submit.sh
[ "${ALGO:-grpo}" != ppo ] || { echo "signed ATLAS needs one advantage sign per trial: ALGO=grpo or reinforce_plus_plus" >&2; return 1; }
PRL_JUDGE_EXTRA_BODY=${PRL_JUDGE_EXTRA_BODY:-'{"reasoning_effort": "low"}'}
TRANSFORM=${TRANSFORM:-atlas_signed}
source "$PRL_ROOT/configs/arms/ota_train_smoke_transform.env"
