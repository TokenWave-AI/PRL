# Train-only replay of an accepted smoke (chain step replay, scripts/chain/replay_check.sh): Miles
# --load-debug-rollout-data trains the smoke's recorded batches (traces/rollout_data/<rollout id>.pt) with the smoke's
# settings and no inference engine, from the base model or a checkpoint in RUN_DIR/ckpt. Each case of the step sets:
#   PRL_REPLAY_DIR             the case's RUN_DIR
#   PRL_REPLAY_DATA            the batches, a path with {rollout_id}
#   PRL_REPLAY_ROLLOUTS        NUM_ROLLOUT (a run resumed from iteration N trains N+1 .. NUM_ROLLOUT-1)
#   PRL_REPLAY_TRAIN_GPUS      the trainer's GPUs (data-parallel ranks; 2 as the smoke)
#   PRL_REPLAY_SAVE_INTERVAL   SAVE_INTERVAL (Miles also saves after the last rollout)
# The reroll smoke's arm: its reward post-process is the identity on batches without added rewards, so any smoke's
# batches replay under it.
TRANSFORM=${TRANSFORM:-reroll_smoke}
source "$PRL_ROOT/configs/arms/ota_train_smoke_reroll.env"
RUN_DIR=${PRL_REPLAY_DIR:?set by scripts/chain/replay_check.sh}
HARBOR_TRIALS_DIR=$RUN_DIR/harbor_trials
NUM_ROLLOUT=${PRL_REPLAY_ROLLOUTS:-2}
ACTOR_GPUS_PER_NODE=${PRL_REPLAY_TRAIN_GPUS:-2}
SAVE_INTERVAL=${PRL_REPLAY_SAVE_INTERVAL:-100000}
# No inference engine to compare weights with; the schedule of these args, not the checkpoint's (a checkpoint of a
# 2-update smoke resumed for a third update; the LR is constant)
EXTRA_ARGS=${EXTRA_ARGS/--check-weight-update-equal --check-weight-update-skip-list visual. /}
EXTRA_ARGS="$EXTRA_ARGS --load-debug-rollout-data ${PRL_REPLAY_DATA:?} --override-opt-param-scheduler"
