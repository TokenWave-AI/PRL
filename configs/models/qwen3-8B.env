# Qwen/Qwen3-8B (official post-trained, hybrid thinking; OpenThinker-Agent-v1 was post-trained from it).
# Model profile contract: README.md in this directory.
MODEL_HF_REPO=Qwen/Qwen3-8B
MODEL_HF_DIR=${MODEL_HF_DIR:-$(ls -d "$HF_HOME"/hub/models--Qwen--Qwen3-8B/snapshots/* 2>/dev/null | head -1 || true)}
MODEL_ARGS_NAME=qwen3-8B
MODEL_TORCH_DIST=$PRL_EXT/ckpt/miles/Qwen3-8B_torch_dist
# Qwen3TITOTokenizer: qwen3_fixed.jinja with clear_thinking=False, so every assistant turn keeps its <think> block.
# The HF template keeps it only after the last user message (Terminus-2 sends each observation as a user message).
# OpenThoughts' RL uses chat_templates/qwen3_thinking_acc.jinja2 for the same reason; it differs from Miles' template
# only for an empty reasoning block, which Miles keeps (the tokens the model generated) and OpenThoughts drops.
TITO_MODEL=qwen3
SGLANG_TOOL_CALL_PARSER=qwen25       # = Qwen3TITOTokenizer.tool_call_parser
SGLANG_REASONING_PARSER=qwen3
MODEL_MAX_CONTEXT=40960              # config.json max_position_embeddings; no rope scaling (YaRN) is configured
