# Qwen/Qwen3.6-35B-A3B (official post-trained, thinking; MoE: 256 experts, top-8 + a shared expert, 40 layers). Train it
# with Rollout Routing Replay; its framework smoke on two nodes of 4 GPUs: configs/arms/ota_train_smoke_moe.env.
# Model profile contract: README.md in this directory.
MODEL_HF_REPO=Qwen/Qwen3.6-35B-A3B
MODEL_HF_DIR=${MODEL_HF_DIR:-$(ls -d "$HF_HOME"/hub/models--Qwen--Qwen3.6-35B-A3B/snapshots/* 2>/dev/null | head -1 || true)}
MODEL_ARGS_NAME=qwen3.6-35B-A3B
MODEL_TORCH_DIST=$PRL_EXT/ckpt/miles/Qwen3.6-35B-A3B_torch_dist
TITO_MODEL=qwen36                    # Qwen36TITOTokenizer: qwen3.6_fixed.jinja
SGLANG_TOOL_CALL_PARSER=qwen3_coder  # = Qwen36TITOTokenizer.tool_call_parser
SGLANG_REASONING_PARSER=qwen3
MODEL_MAX_CONTEXT=262144             # text_config.max_position_embeddings
