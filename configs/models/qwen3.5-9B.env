# Qwen/Qwen3.5-9B (official post-trained, thinking). Default profile for MODEL_SIZE=9B (MODEL unset).
# Model profile contract: README.md in this directory.
MODEL_HF_REPO=Qwen/Qwen3.5-9B
MODEL_HF_DIR=${MODEL_HF_DIR:-${QWEN35_9B:-}}     # scripts/lib/env.sh resolves QWEN35_9B from HF_HOME (or qsub -v QWEN35_9B=...)
MODEL_ARGS_NAME=qwen3.5-9B
MODEL_TORCH_DIST=$PRL_EXT/ckpt/miles/Qwen3.5-9B_torch_dist
TITO_MODEL=qwen35                    # Qwen35TITOTokenizer: qwen3.5_fixed.jinja + preserve_thinking=True
SGLANG_TOOL_CALL_PARSER=qwen3_coder  # = Qwen35TITOTokenizer.tool_call_parser
SGLANG_REASONING_PARSER=qwen3
MODEL_MAX_CONTEXT=262144             # text_config.max_position_embeddings
