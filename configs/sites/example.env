# A site profile: everything about one cluster (or one machine). Copy this file to configs/sites/<site>.env (only
# example.env is tracked: a profile holds your paths, accounts and endpoints), fill in the first block, and select it
# with PRL_SITE=<site>. The launchers source it with set -a, on the login node and in the job. Values written as
# ${VAR:-default} can still be overridden from the environment. Key and password files: chmod 600, never a value here.

# ---- Fill in ----
PRL_SCHEDULER=pbs                          # pbs (PBS Pro), pjm (Fujitsu PJM) or local (no scheduler: this machine)
PRL_PBS_QUEUE="<queue>"                    # pbs: a queue of whole GPU nodes (pjm: PRL_PJM_RSCGRP below)
PRL_EXT=${PRL_EXT:-/path/to/work}          # data, image, checkpoints, runs, logs, keys; every node must see it
# the sandbox service: anything the e2b SDK can talk to (docs/sandboxes.md)
E2B_API_URL="https://<api endpoint>"
E2B_DOMAIN="<sandbox domain>"
E2B_API_KEY_FILE=$PRL_EXT/private/e2b_api_key
# where scripts/setup/build_sandboxes.sh pushes the task images (a registry the sandbox service pulls from), and the
# credentials the service pulls with: {"username": ..., "password": ...}
PRL_REGISTRY="<registry>/<project>"
PRL_REGISTRY_CREDENTIALS_FILE=$PRL_EXT/private/registry_credentials.json
# the judge / teacher of transforms that call `ask` (signed ATLAS, the quick start's default; uncomment): any
# OpenAI-compatible Chat Completions endpoint (all its settings: configs/arms/ota_judge.env)
# PRL_JUDGE_API_BASE=https://<provider>/v1
# PRL_JUDGE_MODEL=<model>
# PRL_JUDGE_KEY_FILE=$PRL_EXT/private/judge_api_key
# PRL_JUDGE_EXTRA_BODY='{"reasoning_effort": "medium"}'   # parameters sent with every request
# PRL_JUDGE_FALLBACK_MODELS=<model>,<model>                # the models to try in turn after a refusal

# ---- Usually as they are ----
PRL_SCRATCH=${PRL_SCRATCH:-${TMPDIR:-/tmp}/rl_scratch}   # per job, node-local and fast (NVMe): overlays, Ray's tmp
HF_HOME=${HF_HOME:-$PRL_EXT/hf_cache}
MILES_IMAGE=${MILES_IMAGE:-$PRL_EXT/sif/miles_v0.1.2.sif}   # the first job pulls it (docker://radixark/miles:v0.1.2)
# PRL_MILES_IMAGE_SOURCE=docker://radixark/miles:v0.1.2   # what it pulls (amd64 and arm64)
PRL_RAY_PLASMA_DIR=${PRL_RAY_PLASMA_DIR:-$PRL_SCRATCH/plasma}       # Ray's object store on the node's NVMe
APPTAINER_TMPDIR=${APPTAINER_TMPDIR:-$PRL_SCRATCH/apptainer_tmp}
APPTAINER_CONFIGDIR=${APPTAINER_CONFIGDIR:-$PRL_SCRATCH/apptainer_cfg}
PRL_MILES_EXTRA_ARGS=${PRL_MILES_EXTRA_ARGS:---pid}                  # extra flags of apptainer exec
PRL_HOST_PYTHON=${PRL_HOST_PYTHON:-python3}   # a Python >= 3.10 on the hosts, for the host-side checks
# The containers see only PRL_ROOT, PRL_EXT, HF_HOME, PRL_SCRATCH and PRL_EXTRA_BINDS: keep the key files under them.
# PRL_EXTRA_BINDS=/dev/shm               # more host paths bound into the container (space-separated)
# PRL_DOCKER_COMMAND="sudo docker"       # how build_sandboxes.sh calls Docker (default sudo docker)

# ---- Only for some sites ----
# Schedulers: further options, or another scheduler (its own scripts/<scheduler>/{submit.sh,job.sh}, about 30 lines
# each: copy one of them). local inside another scheduler's allocation: FOREGROUND=1 (docs/setup.md).
# PRL_PBS_ARGS="-W group_list=<group>"   # pbs: further qsub options
# PRL_PJM_RSCGRP=<resource group>        # pjm: pjsub -L rscgrp=...
# PRL_PJM_ARGS="<options>"              # pjm: further pjsub options
# PRL_PJM_MULTINODE_HOURS=<hours>        # pjm: elapse limit of jobs on more than one node, if it is shorter

# Only an older system Python (< 3.10) on the hosts: run the Miles image's.
# PRL_HOST_PYTHON=$PRL_ROOT/scripts/compat/hostpy
# PRL_SUBMIT_FINDS_SMOKE=0               # the login node cannot run that Python: jobs find their smoke themselves

# SingularityCE instead of Apptainer: the wrapper in scripts/compat takes apptainer's flags.
# PATH=$PRL_ROOT/scripts/compat:$PATH
# PRL_SINGULARITY=/usr/bin/singularity
# PRL_SANDBOX_UNSQUASH=1                 # unpack the image with unsquashfs where `build --sandbox` fails on it

# Compute nodes behind a proxy (http(s)_proxy set in the job): the job's own traffic to its node is exempt
# (scripts/lib/container_main.sh adds the node's addresses to no_proxy). The e2b SDK resolves the proxy's host name
# itself and, where that fails, waits about 15 s per connection: name the proxy by its IP address in https_proxy.

# The launchers' hardware gate checks that a node has the arm's NUM_GPUS GPUs with PRL_GPU_MIN_MIB each, healthy.
# Optionally also the GPU model every node must report:
# PRL_GPU_NAME=<the model name nvidia-smi reports>

# Multi-node jobs (pjm only; arms with NNODES > 1): the job's node list, the command that starts a process on another
# node of the job, and the network interface between nodes (Ray, NCCL and gloo use it)
# PRL_NODE_FILE=${PJM_O_NODEINF:-}
# PRL_REMOTE_EXEC=pjrsh
# PRL_NODE_IFACE=ib0
