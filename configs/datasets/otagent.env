# Dataset preset: open-thoughts/OpenThoughts-Agent-v1-RL (728 nl2bash Harbor tasks), Harbor Terminus-2 harness.
# Sourced by scripts/lib/env.sh when DATASET=otagent. Every value can be overridden from the environment.
# Rows: python -m prl.datasets.harbor.convert --tasks-dir $PRL_EXT/data/harbor_tasks (task_*) --out .../train.jsonl
PROMPT_DATA=${PROMPT_DATA:-$PRL_EXT/data/otagent_rl/train.jsonl}
HARBOR_TASKS_DIR=${HARBOR_TASKS_DIR:-$PRL_EXT/data/harbor_tasks}   # every task dir (train task_* + OpenThoughts-TB-dev uuids; ids disjoint). Real dirs: Miles rejects paths that resolve outside
HARNESS=harbor
THINKING=${THINKING:-true}
