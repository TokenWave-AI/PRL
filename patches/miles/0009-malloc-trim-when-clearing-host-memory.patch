From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Sat, 24 Oct 2026 03:40:00 +0900
Subject: [PATCH] prl: malloc_trim when clearing host memory

---
diff --git a/miles/utils/memory_utils.py b/miles/utils/memory_utils.py
--- a/miles/utils/memory_utils.py
+++ b/miles/utils/memory_utils.py
@@ -1,3 +1,4 @@
+import ctypes
 import gc
 import logging
 
@@ -13,6 +14,13 @@
     torch.cuda.empty_cache()
     if clear_host_memory:
         torch._C._host_emptyCache()
+        # prl: hand freed heap back to the OS (glibc keeps it in every thread's arena). A PPO relay job's actor,
+        # asleep after loading its checkpoint and optimizer, kept ~8 GB more RSS on one node than the others, and the
+        # critic's load next to it pushed that 100 GB node over its limit.
+        try:
+            ctypes.CDLL("libc.so.6").malloc_trim(0)
+        except OSError:
+            pass
 
 
 def available_memory():
