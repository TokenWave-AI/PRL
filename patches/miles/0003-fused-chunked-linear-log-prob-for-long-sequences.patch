From 5175d4a4819d942a62b5196ede979f7c36a47a57 Mon Sep 17 00:00:00 2001
Date: Sun, 4 Oct 2026 23:29:10 +0900
Subject: [PATCH] prl: fused chunked linear+log-prob for long sequences
 (PRL_FUSED_LOGPROB=1)

With PRL_FUSED_LOGPROB=1, both forward_only and train forward steps pass next-token labels so
GPTModel returns per-token -log p(label) [b, s] through Megatron's linear-cross-entropy path, whose
implementation prl.algo.fused_logprob replaces with a chunked, recompute-in-backward kernel
(Megatron's shipped kernel is Blackwell-only). get_log_probs_and_entropy consumes these directly.
Full-vocab logits ([s, 248k]) for 64k-token agent trajectories do not fit on one 96 GB GPU otherwise.
---
 miles/backends/megatron_utils/model.py        | 21 +++++++++++++++++--
 .../loss/hub/logit_processors.py              | 16 ++++++++++++++
 2 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/miles/backends/megatron_utils/model.py b/miles/backends/megatron_utils/model.py
index b22d2dc..3d0aee6 100644
--- a/miles/backends/megatron_utils/model.py
+++ b/miles/backends/megatron_utils/model.py
@@ -279,6 +279,24 @@ def should_disable_forward_pre_hook(args: Namespace) -> bool:
 
 
+def _prl_fused_labels(model, tokens):
+    """prl: with PRL_FUSED_LOGPROB=1 the model returns per-token -log p(next token) [b, s]
+    via a chunked linear+log-prob (prl.algo.fused_logprob) instead of full-vocab logits [b, s, V],
+    which do not fit on one GPU for 64k-token agent trajectories. Returns the next-token labels to pass
+    to the model, or None (unchanged behaviour)."""
+    from prl.algo import fused_logprob
+
+    if not fused_logprob.enabled():
+        return None
+    if not hasattr(model, "_prl_fused_installed"):
+        # False for a PPO critic: its value head ([b, s, 1]) has no vocabulary, so it keeps labels=None
+        model._prl_fused_installed = fused_logprob.install([model]) > 0
+    if not model._prl_fused_installed:
+        return None
+    # labels[t] = tokens[t + 1]; the wrapped-around last position is never read (response logits stop at T-2)
+    return torch.roll(tokens, shifts=-1, dims=-1)
+
+
 @torch.no_grad()
 def forward_only(
     f: Callable[..., dict[str, list[torch.Tensor]]],
     args: Namespace,
@@ -361,7 +379,7 @@ def forward_only(
             input_ids=tokens,
             position_ids=None,
             attention_mask=None,
-            labels=None,
+            labels=_prl_fused_labels(model, tokens),
             packed_seq_params=packed_seq_params,
             loss_mask=batch["input_loss_masks"],
             **(filter_keys(batch, ["witness_ids"]) if args.enable_witness else {}),
@@ -517,7 +535,7 @@ def run_forward_backward_pass(
                 "input_ids": batch["tokens"],
                 "position_ids": None,
                 "attention_mask": None,
-                "labels": None,
+                "labels": _prl_fused_labels(model, batch["tokens"]),
                 "packed_seq_params": get_packed_seq_params(batch, args),
                 # Aligned with input_ids. With labels=None, Megatron derives the MTP labels
                 # from input_ids and shifts this mask itself; without MTP it never reads it.
diff --git a/miles/backends/training_utils/loss/hub/logit_processors.py b/miles/backends/training_utils/loss/hub/logit_processors.py
index 4066096..b7377d1 100644
--- a/miles/backends/training_utils/loss/hub/logit_processors.py
+++ b/miles/backends/training_utils/loss/hub/logit_processors.py
@@ -51,6 +51,9 @@ def _iter_response_chunks(
     if not args.true_on_policy_mode:
         # Model-precision callers hand native bf16/fp16 logits; chunks are upcast to fp32 downstream
         assert logits.dtype in (torch.float32, torch.bfloat16, torch.float16), f"{logits.dtype}"
+    if len(logits.shape) == 2:
+        # prl fused log-prob: [b, s] per-token -log p(next token) -> [b, s, 1] "logits" rows
+        logits = logits.unsqueeze(-1)
     assert len(logits.shape) == 3, f"{logits.shape}"
 
     if qkv_format == "thd":
@@ -184,6 +187,10 @@ def get_responses(
         yield logits_chunk, tokens_chunk
 
 
+def sampling_mask_unused(rollout_sampling_mask) -> bool:
+    return rollout_sampling_mask is None
+
+
 def get_log_probs_and_entropy(
     logits: torch.Tensor,
     *,
@@ -244,7 +251,16 @@ def get_log_probs_and_entropy(
         max_seq_lens=max_seq_lens,
         include_response_indices=rollout_sampling_mask is not None,
     )
+    fused = logits.dim() == 2  # prl fused log-prob: model output is -log p(next token), see model.py
+    if fused:
+        assert sampling_mask_unused(rollout_sampling_mask), "prl fused log-prob: no rollout sampling masks"
+        assert args.rollout_temperature == 1.0 or args.true_on_policy_mode, "prl fused log-prob needs temperature 1"
     for sample_index, (logits_chunk, tokens_chunk, response_indices) in enumerate(response_chunks):
+        if fused:
+            log_probs_list.append(-logits_chunk.squeeze(-1))
+            if with_entropy:  # not computable without the full distribution; only used for logging here
+                entropy_list.append(torch.zeros_like(logits_chunk.squeeze(-1)).detach())
+            continue
         sampling_mask = None
         if rollout_sampling_mask is not None:
             sampling_mask = build_local_sampling_mask(
